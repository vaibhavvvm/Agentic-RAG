# ============================================================
# RAG Environment Variables — Cloud Live Setup
# ============================================================

# ----- Backend Selection -----
VECTOR_BACKEND=pinecone          # pinecone | pgvector | memory | auto
GRAPH_BACKEND=auradb             # auradb | neo4j | falkor | pggraph | none
EMBEDDING_BACKEND=gemini         # gemini | ollama
LLM_FALLBACK_CHAIN=gemini,groq,openrouter
RERANKER_BACKEND=gemini          # gemini | local_hf | ollama | lexical

# ----- Google Gemini (Primary LLM & Embedding) -----
GEMINI_API_KEY=AIzaSy...
GEMINI_PRIMARY_MODEL=gemini-3.5-flash
GEMINI_THINKING_MODEL=gemini-3.7-flash
GEMINI_FAST_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# ----- Pinecone Serverless (Vector DB) -----
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=agentic-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine
PINECONE_DIMENSION=768

# ----- Neo4j AuraDB Cloud (Graph DB) -----
NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-auradb-password
NEO4J_DATABASE=neo4j

# ----- Groq (Fallback #1) -----
GROQ_API_KEY=gsk_...
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ----- OpenRouter (Fallback #2) -----
OPENROUTER_API_KEY=sk-or-v1-...

# ----- Local Fallback Settings (Optional) -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
